{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.engine-out",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "types": ["vite/client"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // This directory vendors the framework-agnostic AVG story engine from
    // arknights-story-player, authored and verified against TypeScript ~5.9
    // (see its tsconfig + passing `vue-tsc -b`). Under TS 6.0's stricter
    // inference the same verified code trips several flags:
    //   - unused locals/params that are deliberate API surfaces,
    //   - element-nullability on array `.map()` results (strictNullChecks),
    //   - a couple of pixi Container runtime methods no longer in the .d.ts.
    // The engine is covered by its own upstream test suite, so rather than
    // rewrite verified behavior for the stricter compiler we compile it under
    // the configuration it was written for.
    "strict": false,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false
  },
  "include": [
    "src/widgets/StoryPlayer/engine/**/*.ts",
    "src/widgets/StoryPlayer/context.ts",
    "src/widgets/StoryPlayer/assets.ts"
  ]
}
