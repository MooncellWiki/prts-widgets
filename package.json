{
  "name": "mooncell-widget",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "scripts": {
    "create": "tsx scripts/index.ts",
    "upload": "tsx scripts/upload.ts",
    "update": "tsx scripts/update.ts",
    "update:ssr": "tsx scripts/update-ssr.ts",
    "prune": "tsx scripts/prune.ts",
    "dev": "vite",
    "build": "vue-tsc -b && vite build && pnpm run prerender",
    "prerender": "vite build -c vite.config.prerender.ts && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:story-log": "vitest run -c vitest.config.storylog.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@sentry/browser": "^10.73.0",
    "@urlpack/json": "^2.0.1",
    "@vicons/material": "^0.13.0",
    "@vueuse/core": "^14.4.0",
    "@zumer/snapdom": "^2.24.15",
    "crypto-js": "^4.2.0",
    "hammerjs": "^2.0.8",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "naive-ui": "^2.45.3",
    "pixi.js": "8.20.1",
    "tippy.js": "6.3.7",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
    "@eslint/js": "^10.0.1",
    "@types/ali-oss": "^6.23.3",
    "@types/crypto-js": "^4.2.2",
    "@types/hammerjs": "^2.0.46",
    "@types/howler": "^2.2.13",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.3",
    "@unocss/eslint-config": "^66.9.1",
    "@unocss/preset-uno": "^66.9.1",
    "@unocss/transformer-directives": "^66.9.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.12.2",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.103.1",
    "simple-git-hooks": "^2.14.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "unocss": "^66.9.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,vue,json}": [
      "eslint --fix --cache"
    ]
  }
}
